{% if driver_standings and next_race %}
<div class="layout layout--col">
  <div class="grid grid--cols-3 h--full gap--large lg:gap--xlarge">
    <div class="flex flex--col gap--small">
      <div class="p--4 stretch bg--gray-75 rounded--small">

        {% comment %} Race Status {% endcomment %}
        {% assign race_tag_css = 'p--1 lg:p--2 lg:pb--1 shadow rounded--xsmall' %}
        <div class="flex flex--col flex--left">
          {% if race_status == 'LIVE' %}
          <span class="label--small lg:value--xxsmall bg--black text--white {{race_tag_css}}">LIVE</span>
          {% elsif race_status == 'COUNTDOWN' %}
          <span class="label--small lg:value--xxsmall bg--gray-20 text--white {{race_tag_css}}">RACE DAY</span>
          {% else %}
          <span class="label--small lg:value--xxsmall bg--white {{race_tag_css}}">NEXT RACE</span>
          {% endif %}
        </div>

        {% comment %} Race Details {% endcomment %}
        <div class="text-stroke flex flex--col flex--left gap ">
          <img class="w--auto h--[115px] w--[230px] lg:w--[300px] lg:h--[210px] lg:portrait:w--[200px] lg:portrait:h--[200px] image image--contain" src="https://trmnl.achtnegen.nl/F1-dashboard/circuit/{{ next_race.Circuit.circuitId }}.png">
          <div class="title title--small lg:title--large">{{ next_race.raceName }}</div>

          <div class="flex gap--medium lg:grid lg:block">
            {% comment %} Countdown / Date {% endcomment %}
            {% if race_status == 'COUNTDOWN' %}
            <div>
              <div class="label--small ">Race starts in</div>
              <div class="label">{{ countdown_hours }}h {{ countdown_minutes }}m</div>
            </div>
            {% else %}
            <div class="">
              <div class="label--small">Race Date</div>
              <div class="label ">{{ race_date_formatted }}</div>
            </div>
            {% endif %}

            <div>
              <div class="label--small">Round</div>
              <div class="label">Round {{ next_race.round }}</div>
            </div>
          </div>

          <div class="md:hidden lg:block">
            <div class="label--small">Location</div>
            <div class="label">{{ next_race.Circuit.Location.locality }}, {{ next_race.Circuit.Location.country }}</div>
          </div>

          <div class="md:hidden lg:block">
            <div class="label--small">Circuit</div>
            <div class="label">{{ next_race.Circuit.circuitName }}</div>
          </div>
        </div>
      </div>

      {% comment %} Session Schedule {% endcomment %}
      <div class="flex flex--col flex--left gap--none w--full p--4 bg--gray-70 rounded">
        <div class="title title--small lg:title--base mb--2 lg:mb--3">SCHEDULE</div>

        <div class="flex flex--row w--full lg:mb--1">
          <span class="stretch label--small lg:value--xxsmall bold">FRIDAY</span>
        </div>

        {% if next_race.FirstPractice %}
        <div class="flex flex--row w--full lg:mb--1 {% if fp1_status == 'done' %}text--gray-50{% else %}text--black{% endif %}">
          <span class="stretch label--small lg:value--xxsmall">Free practice 1</span>
          <span class="label--small lg:value--xxsmall">{{ fp1_display }}</span>
        </div>
        {% endif %}

        {% if next_race.SecondPractice %}
        <div class="flex flex--row w--full lg:mb--1 gap--small lg:mb--1 {% if fp2_status == 'done' %}text--gray-50{% else %}text--black{% endif %}">
          <span class="stretch label--small lg:value--xxsmall">Free practice 2</span>
          <span class="label--small lg:value--xxsmall">{{ fp2_display }}</span>
        </div>
        {% endif %}

        {% if next_race.SprintQualifying %}
        <div class="flex flex--row w--full lg:mb--1 gap--small {% if sprint_quali_status == 'done' %}text--gray-50{% else %}text--black{% endif %}">
          <span class="stretch label--small lg:value--xxsmall">Sprint Qualifying</span>
          <span class="label--small lg:value--xxsmall">{{ sprint_quali_display }}</span>
        </div>
        {% endif %}

        <div class="flex flex--row w--full gap--small mt--2 lg:mb--1">
          <span class="stretch label--small lg:value--xxsmall bold">SATURDAY</span>
        </div>

        {% if next_race.ThirdPractice %}
        <div class="flex flex--row w--full lg:mb--1 gap--small {% if fp3_status == 'done' %}text--gray-50{% else %}text--black{% endif %}">
          <span class="stretch label--small lg:value--xxsmall">Free practice 3</span>
          <span class="label--small lg:value--xxsmall">{{ fp3_display }}</span>
        </div>
        {% endif %}

        {% if next_race.Sprint %}
        <div class="flex flex--row w--full lg:mb--1 gap--small {% if sprint_status == 'done' %}text--gray-50{% else %}text--black{% endif %}">
          <span class="stretch label--small lg:value--xxsmall">Sprint</span>
          <span class="label--small lg:value--xxsmall">{{ sprint_display }}</span>
        </div>
        {% endif %}

        {% if next_race.Qualifying %}
        <div class="flex flex--row w--full lg:mb--1 gap--small {% if quali_status == 'done' %}text--gray-50{% else %}text--black{% endif %}">
          <span class="stretch label--small lg:value--xxsmall">Qualifying</span>
          <span class="label--small lg:value--xxsmall">{{ quali_display }}</span>
        </div>
        {% endif %}

        <div class="flex flex--row w--full gap--small mt--2 lg:mb--1">
          <span class="stretch label--small bold lg:value--xxsmall">SUNDAY</span>
        </div>

        <div class="flex flex--row w--full lg:mb--1 gap--small">
          <span class="stretch label--small lg:value--xxsmall">Race</span>
          <span class="label--small lg:value--xxsmall">{{ race_display }}</span>
        </div>
      </div>

    </div>

    <div class="col--span-2 flex flex--col gap--none pt--3">
      <div class="w--full">
        {% if show_qualifying %}
        <span class="title title--small lg:title--base lg:portrait:title--base">🏁 STARTING GRID</span>
        {% else %}
        <span class="title title--small lg:title--base lg:portrait:title--base"">DRIVER STANDINGS <span class="text--gray-20">{{ standings_season }}</span> </span>
        {% endif %}
      </div>

      <div class="flex flex--col w--full gap--xsmall">

        {% if show_qualifying %}
        <table class="table" data-table-limit="true">
          <thead>
            <tr>
              <th><span class="label--small"></span></th>
              <th><span class="label--small">Driver</span></th>
              <th><span class="label--small">Q3</span></th>
              <th><span class="label--small">Q2</span></th>
              <th><span class="label--small">Q1</span></th>
            </tr>
          </thead>
          <tbody>
            {% for result in qualifying_results limit: 20 %}
            <tr class="
              hidden
              {% if forloop.index < 9 %}table-row{% endif %}
              {% if forloop.index < 15 %}lg:table-row{% endif %}
              {% if forloop.index < 21 %}lg:portrait:table-row{% endif %}
              ">
              <td><span class="label w--[20px]">{{ result.position }}</span></td>
              <td><span class="label">
                <div class="w--[32px] h--[32px] mr--2 bg--gray-75 rounded--full"><img class="image-dither w--full h--full image image--cover avatar" src="https://trmnl.achtnegen.nl/F1-dashboard/drivers/{{ result.Driver.permanentNumber }}.avif"></div>
                {{ result.Driver.givenName }} {{ result.Driver.familyName }}
              </span></td>
              <td><span class="label label--small">{{ result.Q3 }}</span></td>
              <td><span class="label label--small">{{ result.Q2 }}</span></td>
              <td><span class="label label--small">{{ result.Q1 }}</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
        <table class="table mt--3" data-table-limit="true">
          <tbody>
            {% for standing in driver_standings limit: 20 %}
            <tr class="
              hidden
              {% if forloop.index < 6 %}table-row{% endif %}
              {% if forloop.index < 11 %}lg:table-row{% endif %}
              {% if forloop.index < 16 %}lg:portrait:table-row{% endif %}
              ">
              <td class="w--8"><span class="label">{{ standing.position }}</span></td>
              <td><span class="label">
                <div class="w--[32px] h--[32px] mr--2 bg--gray-75 rounded--full"><img class="image-dither w--full h--full image image--cover avatar" src="https://trmnl.achtnegen.nl/F1-dashboard/drivers/{{ standing.Driver.permanentNumber }}.avif"></div>
                {{ standing.Driver.givenName }} {{ standing.Driver.familyName }}
              </span></td>
              <td><span class="label label--small">
                <div class="w--[24px] h--[24px] mr--2 bg--black rounded--full p--1"><img class="image-dither w--full h--full image image--cover avatar" src="https://trmnl.achtnegen.nl/F1-dashboard/constructor/{{ standing.Constructors[0].constructorId }}.avif"></div>
                {{ standing.Constructors[0].name | truncate: 15 }}</span></td>
              <td class="w--12"><span class="label">{{ standing.points }}</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>

        <span class="title title--small lg:title--base lg:portrait:title--base w--full mt--5 lg:mt--3 lg:portrait:mb--2">CONSTRUCTOR STANDINGS <span class="text--gray-20">{{ standings_season }}</span> </span>

        <table class="table mt--2" data-table-limit="true">
          <tbody>
            {% for team in constructor_standings limit: 5 %}
            <tr class="
              hidden
              {% if forloop.index < 4 %}table-row{% endif %}
              {% if forloop.index < 5 %}lg:table-row{% endif %}
              {% if forloop.index < 21 %}lg:portrait:table-row{% endif %}
              ">
              <td class="w--8"><span class="label">{{ team.position }}</span></td>
              <td><span class="label">
                <div class="w--[32px] h--[32px] mr--2 bg--black rounded--full p--1"><img class="image-dither w--full h--full image image--cover avatar" src="https://trmnl.achtnegen.nl/F1-dashboard/constructor/{{ team.Constructor.constructorId }}.avif"></div>
                {{ team.Constructor.name | truncate: 15 }}
              </span></td>
              <td class="w--12"><span class="label">{{ team.points }}</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% endif %}

      </div>

    </div>
  </div>
</div>

{% else %}
<div class="layout">
  <div class="flex flex--col flex--center-x flex--center-y h--full">
    <span class="title title--large mb--small">🏎️ Getting F1 Data</span>
    <span class="label text--gray">3.. 2... 1... please wait.</span>
  </div>
</div>
{% endif %}
